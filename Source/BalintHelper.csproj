<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net8.0</TargetFramework>
<LangVersion>latest</LangVersion>
<AssemblyName>BalintHelper</AssemblyName>
<RootNamespace>Celeste.Mod.BalintHelper</RootNamespace>
<Nullable>enable</Nullable>
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
<CelestePrefix Condition="'$(CelestePrefix)' == '' And '$(CelesteDir)' != ''">$(CelesteDir)</CelestePrefix>
<CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('..\..\..\..\Celeste.dll')">..\..\..\..</CelestePrefix>
<CelestePrefix Condition="'$(CelestePrefix)' == ''">..\lib-stripped</CelestePrefix>
</PropertyGroup>

<ItemDefinitionGroup>
<PackageReference PrivateAssets="all" ExcludeAssets="runtime" />
<Reference Private="false" />
</ItemDefinitionGroup>

<ItemGroup>
<PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
<PackageReference Include="MonoMod.Patcher" Version="25.0.0-prerelease.2" />
<PackageReference Include="CelesteAnalyzer" Version="*" />
<PackageReference Include="CelesteMod.Publicizer" Version="*" CelesteAssembly="$(CelestePrefix)\Celeste.dll" />
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\DynamicInstructions\DynamicInstructions.csproj" />
</ItemGroup>

<ItemGroup>
<Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" Private="false" />
<Reference Include="$(CelestePrefix)\FNA.dll" Private="false" />
</ItemGroup>

<Target Name="CopyFiles" AfterTargets="Build" Inputs="$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\$(AssemblyName).pdb" Outputs="..\bin\$(AssemblyName).dll;..\bin\$(AssemblyName).pdb">
<Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="..\bin" />
<Copy SourceFiles="$(OutputPath)\$(AssemblyName).pdb" DestinationFolder="..\bin" />
</Target>

<Target Name="StageModFolder" AfterTargets="CopyFiles">
<PropertyGroup>
<ModStageDir>..\BalintHelper\</ModStageDir>
</PropertyGroup>

<Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="$(ModStageDir)bin" />
<Copy SourceFiles="$(OutputPath)\$(AssemblyName).pdb" DestinationFolder="$(ModStageDir)bin" />
<Copy SourceFiles="..\everest.yaml" DestinationFolder="$(ModStageDir)" Condition="Exists('..\everest.yaml')" />

<ItemGroup>
<AssetFiles Include="..\Assets\**\*.*" Condition="Exists('..\Assets')" />
</ItemGroup>

<Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(ModStageDir)%(RecursiveDir)" />
<Message Text="Mod staged at: $(ModStageDir)" Importance="high" />
</Target>

<PropertyGroup>
<PathMap>$(MSBuildProjectDirectory)=BalintHelper/</PathMap>
</PropertyGroup>

<PropertyGroup>
<NoWarn>$(NoWarn);IDE0130</NoWarn>
<NoWarn>$(NoWarn);IDE0290</NoWarn>
</PropertyGroup>
</Project>